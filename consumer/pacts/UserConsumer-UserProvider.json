{
  "consumer": {
    "name": "UserConsumer"
  },
  "interactions": [
    {
      "description": "a request for user with ID 1",
      "providerState": "a user with ID 1 exists",
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/user/1"
      },
      "response": {
        "body": {
          "age": 30,
          "id": 1,
          "name": "John Doe"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "$.body.age": {
            "match": "type"
          },
          "$.body.id": {
            "match": "type"
          },
          "$.body.name": {
            "match": "type"
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "13.2.0"
    },
    "pactRust": {
      "ffi": "0.4.22",
      "models": "1.2.3"
    },
    "pactSpecification": {
      "version": "2.0.0"
    }
  },
  "provider": {
    "name": "UserProvider"
  }
}